@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var readingsHistory = controller == "Readings" && action != "Create" ? "active" : "";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ระบบบันทึกค่าอ่านมิเตอร์น้ำและไฟฟ้า</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
    <aside class="sidebar" id="sidebar" aria-label="เมนูหลัก">
        <a class="brand" asp-controller="Dashboard" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-speedometer2"></i></span>
            <span class="brand-text">
                <strong>MeterPro</strong>
                <small>ระบบค่าอ่านมิเตอร์น้ำ-ไฟ</small>
            </span>
        </a>

        <nav class="side-nav">
            <div class="nav-label">ภาพรวม</div>
            <a class="side-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2"></i><span>แดชบอร์ด</span>
            </a>
            <div class="nav-label">งานหลัก</div>
            <a class="side-link @Active("Meters")" asp-controller="Meters" asp-action="Index">
                <i class="bi bi-hdd-stack"></i><span>จัดการมิเตอร์</span>
            </a>
            <a class="side-link @Active("Readings", "Create")" asp-controller="Readings" asp-action="Create">
                <i class="bi bi-pencil-square"></i><span>บันทึกค่าอ่าน</span>
            </a>
            <a class="side-link @readingsHistory" asp-controller="Readings" asp-action="Index">
                <i class="bi bi-clock-history"></i><span>ประวัติการอ่าน</span>
            </a>
            <div class="nav-label">วิเคราะห์</div>
            <a class="side-link @Active("Reports")" asp-controller="Reports" asp-action="Index">
                <i class="bi bi-file-earmark-bar-graph"></i><span>รายงาน</span>
            </a>
        </nav>

        <div class="side-footer">
            <i class="bi bi-database-check"></i>
            <span>SQLite · ข้อมูลจริง</span>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" id="sidebarToggle" type="button" aria-label="เปิดเมนู">
                <i class="bi bi-list"></i>
            </button>
            <div class="topbar-title">
                <h1>@ViewData["Title"]</h1>
                @if (ViewData["Subtitle"] is string sub)
                {
                    <p>@sub</p>
                }
            </div>
            <div class="topbar-actions">
                <span class="today d-none d-md-inline-flex"><i class="bi bi-calendar3"></i> @DateTime.Today.ToString("dd/MM/yyyy")</span>
                <a class="btn btn-primary btn-sm" asp-controller="Readings" asp-action="Create">
                    <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> บันทึกค่าอ่าน</span>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-light btn-sm" title="ออกจากระบบ">
                        <i class="bi bi-box-arrow-right"></i><span class="d-none d-md-inline"> ออกจากระบบ (@User.Identity?.Name)</span>
                    </button>
                </form>
            </div>
        </header>

        <main class="content">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show flash" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="ปิด"></button>
                </div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show flash" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@err
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="ปิด"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="footer no-print">
            © @DateTime.Today.Year ระบบบันทึกค่าอ่านมิเตอร์น้ำและไฟฟ้า · ASP.NET Core MVC + SQLite
        </footer>
    </div>
</div>

<!-- Shared delete confirmation (prevents accidental deletes). Buttons set data-delete-url / data-delete-message. -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" class="modal-content" id="confirmDeleteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" id="confirmDeleteReturn" />
            <div class="modal-body text-center p-4">
                <div class="danger-icon"><i class="bi bi-trash3"></i></div>
                <h5 class="mt-3 mb-2">ยืนยันการลบข้อมูล</h5>
                <p class="text-secondary mb-0" id="confirmDeleteMessage">ต้องการลบรายการนี้หรือไม่?</p>
                <p class="small text-danger mt-2 mb-0">การลบไม่สามารถย้อนกลับได้</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash3 me-1"></i>ลบข้อมูล</button>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
